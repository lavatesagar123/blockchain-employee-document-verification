# Django Core Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=trustdoc_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Frontend CORS Origins & Verification URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# JWT Settings
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Media Directory (relative to backend/ or absolute path)
MEDIA_ROOT=media

# Platform Super Admin Seeding (used by `python manage.py ensure_admin`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@trustdoc.local
ADMIN_PASSWORD=replace-with-strong-admin-password
